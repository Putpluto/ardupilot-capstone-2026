# hw definition file for generic STM32H743VIT6 dev board
# Custom mod: I2C IMU (ASM330), GPS on USART1, 4 Servos, NO OSD, NO Ext Flash, NO Baro

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# Board ID for firmware load
APJ_BOARD_ID AP_HW_H743VIT6_DEV

# Crystal frequency (Most generic H743 boards use 25MHz external oscillators)
OSCILLATOR_HZ 25000000
FLASH_SIZE_KB 2048

# Bootloader takes first 128KB on H7 (Sector 0)
FLASH_RESERVE_START_KB 128

# Parameter storage in INTERNAL flash (Sector 1)
define HAL_STORAGE_SIZE 16384
define STORAGE_FLASH_PAGE 1

# System timer
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# Onboard Status LED (Common on WeAct STM32H743 is PE3. Change to PC13 if needed)
PE3 LED_BLUE OUTPUT LOW GPIO(0)
define HAL_GPIO_A_LED_PIN 0

# Beeper
PC2 BUZZER OUTPUT GPIO(80) LOW PULLDOWN
define HAL_BUZZER_PIN 80

# ----------------- PWM OUTPUTS (4 Servos) -----------------
# Mapped to TIM2 (PA0 - PA3)
PA0 TIM2_CH1 TIM2 PWM(1) NODMA
PA1 TIM2_CH2 TIM2 PWM(2) NODMA
PA2 TIM2_CH3 TIM2 PWM(3) NODMA
PA3 TIM2_CH4 TIM2 PWM(4) NODMA

# ----------------- SERIAL PORTS -----------------
# Order: USB, GPS(1), RCIN(5), Telemetry(3)
SERIAL_ORDER OTG1 USART1 UART5 USART3

# USB and Debug Pins
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# USART1 (GPS1)
PA10 USART1_RX USART1
PA9 USART1_TX USART1
define DEFAULT_SERIAL1_PROTOCOL SerialProtocol_GPS

# UART5 (RC Input - Ideal for CRSF/ELRS or SBUS)
PB5 UART5_RX UART5
PB6 UART5_TX UART5
define DEFAULT_SERIAL5_PROTOCOL SerialProtocol_RCIN

# USART3 (Telemetry)
PD8 USART3_TX USART3
PD9 USART3_RX USART3

# ----------------- I2C & SENSORS -----------------
I2C_ORDER I2C2

# I2C2 Hardware Pins
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2

# IMU Configuration (Requires your custom ASM330 driver compiled in your tree)
IMU ASM330 I2C:0:0x6A ROTATION_NONE

# Disable Barometer for bench testing
define AP_BARO_BACKEND_DEFAULT_ENABLED 0
define HAL_BARO_ALLOW_NODETECT 1

# Disable External Compass (Minimal Build)
define HAL_COMPASS_DEFAULT HAL_COMPASS_NONE

# ----------------- ADC -----------------
# ADC1 - Current Sensor
PC0 BATT_CURRENT_SENS ADC1 SCALE(1)
define HAL_BATT_CURR_PIN 10
define HAL_BATT_CURR_SCALE 83.3

# ADC1 - Voltage Sensor
PC1 BATT_VOLTAGE_SENS ADC1 SCALE(1)
define HAL_BATT_VOLT_PIN 11
define HAL_BATT_VOLT_SCALE 18.18