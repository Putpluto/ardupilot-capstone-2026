# hwdef-bl.dat for generic STM32H743VIT6 dev board bootloader

MCU STM32H7xx STM32H743xx

# MUST match the ID in your main hwdef.dat
APJ_BOARD_ID AP_HW_DAKEFPVH743PRO

OSCILLATOR_HZ 25000000
FLASH_SIZE_KB 2048

# Bootloader lives at the very start of memory
FLASH_RESERVE_START_KB 0

# MUST match FLASH_RESERVE_START_KB from your main hwdef.dat
FLASH_BOOTLOADER_LOAD_KB 128

# Only USB is needed for the bootloader
SERIAL_ORDER OTG1

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# Standard Dev Board LED (Change to PC13 if your specific board differs)
PE3 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 0